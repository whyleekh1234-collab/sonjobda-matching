# .env.local로 복사한 뒤 값을 채운다.
# Supabase 대시보드 > Project Settings > API Keys 에서 확인한다.

# 공개값. 브라우저 번들에 포함된다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버 전용. RLS를 우회하므로 클라이언트에 노출되면 전체 데이터가 열린다.
# 이메일 찾기 인증번호를 서버만 만들고 서버만 읽기 위해 필요하다.
# 없으면 이메일 찾기가 동작하지 않는다(다른 기능은 영향 없음).
SUPABASE_SECRET_KEY=sb_secret_...

# 메일 발송 (https://resend.com). 없으면 메일을 보내지 않고, 개발 환경에서는
# 화면에 인증번호와 초대 링크를 대신 보여준다.
RESEND_API_KEY=re_...

# 보내는 사람. 도메인 인증을 마치기 전에는 resend.dev 주소만 쓸 수 있고
# 본인 주소로만 발송된다. 임의의 회원에게 보내려면 도메인 인증이 필요하다.
EMAIL_FROM=손잡다매칭 <onboarding@resend.dev>

# 국세청 사업자등록번호 조회 (https://www.data.go.kr).
# "국세청_사업자등록정보 진위확인 및 상태조회 서비스"를 신청하고 받은
# 일반 인증키(Decoding)를 넣는다. 없으면 검증을 건너뛰고 가입은 그대로 된다.
NTS_SERVICE_KEY=
